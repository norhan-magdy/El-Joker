# Absolute API base URL. No trailing slash.
# Omit to derive it per platform (localhost:8000 on iOS/web, 10.0.2.2:8000 on Android emulators).
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Host used when EXPO_PUBLIC_API_URL is unset.
# Android emulators must use 10.0.2.2, not localhost.
# Physical devices must use your machine's LAN IP, e.g. 192.168.1.20:8000
EXPO_PUBLIC_API_HOST=192.168.1.20:8000
